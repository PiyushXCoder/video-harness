.DS_Store
*.log
node_modules/
__pycache__/

# raw/processed/manim/remotion outputs are large binaries — don't commit media
raw/*
processed/*
manim/*
remotion/*
screencasts/*
audio/*
memes/*
!*/.gitkeep

# Manim's own render cache/output — regenerable, large
.manim/media/

# Remotion's own render output — regenerable, large (node_modules/ rule above covers deps)
.remotion/out/
